(
    set -euo pipefail

    cd ~/Proyectos/FumetaOS

    mapfile -d '' CHECK_FILES < <(
        find bin core modules apps install \
            -type f \
            \( -name '*.sh' -o -path 'bin/*' \) \
            -print0 |
            sort -z
    )

    echo "===== FORMATEANDO SCRIPTS ====="
    shfmt -w "${CHECK_FILES[@]}"

    echo
    echo "===== COMPROBANDO FORMATO ====="
    shfmt -d "${CHECK_FILES[@]}"

    echo
    echo "===== COMPROBANDO SINTAXIS ====="
    for FILE in "${CHECK_FILES[@]}"
    do
        bash -n "$FILE"
    done

    echo
    echo "===== COMPROBANDO CAMBIOS ====="
    git diff --check
    git diff --stat

    echo
    echo "===== ESTADO ====="
    git status --short

    echo
    echo "✅ Formato uniforme aplicado correctamente"
)
