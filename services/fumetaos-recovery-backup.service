[Unit]
Description=Copia incremental de recuperación completa de FumetaOS
After=network-online.target docker.service casaos.service
Wants=network-online.target
RequiresMountsFor=/mnt/datos
OnFailure=fumetaos-recovery-alert@%n.service

[Service]
Type=oneshot
User=root
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=6h
ExecStart=/opt/fumetaos/bin/fumetaos-recovery-backup create
