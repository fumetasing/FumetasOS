[Unit]
Description=Montaje SMB 3.1.1 de la Time Capsule para FumetaOS
After=network-online.target
Wants=network-online.target
Before=docker.service casaos.service fumetaos-timecapsule-casaos.service
StartLimitIntervalSec=10min
StartLimitBurst=12

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Restart=on-failure
RestartSec=15s
TimeoutStartSec=90s
TimeoutStopSec=30s
ExecStart=/opt/fumetaos/bin/fumetaos-timecapsule mount
ExecStartPost=/usr/bin/systemctl --no-block restart fumetaos-timecapsule-casaos.service
ExecStop=/opt/fumetaos/bin/fumetaos-timecapsule unmount

[Install]
WantedBy=multi-user.target
