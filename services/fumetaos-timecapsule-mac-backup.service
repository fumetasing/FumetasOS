[Unit]
Description=Copia espejo nocturna de Time Capsule al Mac
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/DATA/TimeCapsule
OnSuccess=fumetaos-mac-backup.service

[Service]
Type=oneshot
User=root
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=24h
ExecStart=/opt/fumetaos/bin/fumetaos-timecapsule-mac-backup
