#!/bin/bash

###########################################################
# FumetaOS
# Telegram Notify
###########################################################

CONFIG="/opt/fumetaos/config/fumetaos.conf"

###########################################################
# Configuración
###########################################################

if [ ! -f "$CONFIG" ]; then
	echo "No existe $CONFIG"
	exit 1
fi

# Configuración local cargada dinámicamente.
# shellcheck disable=SC1090
. "$CONFIG"

if [ -z "$TELEGRAM_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ]; then
	echo "Telegram no configurado"
	exit 1
fi

###########################################################
# Mensaje
###########################################################

MESSAGE="$(</dev/stdin)"

if [ -z "$MESSAGE" ]; then
	echo "Mensaje vacío"
	exit 1
fi

###########################################################
# Envío Telegram
###########################################################

RESPONSE="$(
	curl -s \
		-X POST \
		"https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage" \
		-d chat_id="$TELEGRAM_CHAT_ID" \
		--data-urlencode text="$MESSAGE"
)"

###########################################################
# Validación
###########################################################

if printf '%s\n' "$RESPONSE" | grep -q '"ok":true'; then
	exit 0
fi

echo "Error enviando Telegram"
printf '%s\n' "$RESPONSE"

exit 1
