#!/bin/bash

set -euo pipefail

LOCK_FILE="/run/lock/fumetaos-system-upgrade.lock"
APT_LOCK_TIMEOUT="1800"

mostrar_error()
{
    echo "❌ $1"
    exit 20
}

[ "$(id -u)" -eq 0 ] ||
    mostrar_error "Esta actualización debe ejecutarse como root"

command -v apt-get >/dev/null 2>&1 ||
    mostrar_error "APT no está disponible"

exec 9>"$LOCK_FILE"

flock -n 9 ||
    mostrar_error "Ya hay una actualización del sistema en curso"

export DEBIAN_FRONTEND=noninteractive

APT_OPTIONS=(
    -o "DPkg::Lock::Timeout=$APT_LOCK_TIMEOUT"
    -o Dpkg::Options::=--force-confold
)

echo "🔄 Actualización semanal de Ubuntu"
echo

echo "📥 Actualizando índices de paquetes"
apt-get "${APT_OPTIONS[@]}" update

echo
echo "📦 Instalando actualizaciones normales"
apt-get "${APT_OPTIONS[@]}" \
    --yes \
    upgrade

echo
echo "📦 Resolviendo actualizaciones completas"
apt-get "${APT_OPTIONS[@]}" \
    --yes \
    dist-upgrade

if [ -f /var/run/reboot-required ]; then
    echo
    echo "🟡 Hay un reinicio pendiente, pero no se reiniciará automáticamente"
fi

echo
echo "✅ Actualización semanal completada"
