#!/bin/bash

###########################################################
# FumetaOS
# Main CLI
###########################################################

BIN_DIR="$(dirname "$0")"

source "$BIN_DIR/../core/common.sh"


case "$1" in


health)

    exec "$BIN_DIR/fumetaos-health"
    ;;


status)

    exec "$BIN_DIR/fumetaos-status"
    ;;


report)

    exec "$BIN_DIR/fumetaos-report"
    ;;


doctor)

    exec "$BIN_DIR/fumetaos-doctor"
    ;;


version)

    exec "$BIN_DIR/fumetaos-version"
    ;;


app)

    shift
    exec "$BIN_DIR/fumetaos-app" "$@"
    ;;


system)

    shift
    exec "$BIN_DIR/fumetaos-system" "$@"
    ;;


watch)

    shift
    exec "$BIN_DIR/fumetaos-watch" "$@"
    ;;


backup)

    exec "$BIN_DIR/fumetaos-backup"
    ;;


history)

    exec "$BIN_DIR/fumetaos-history"
    ;;


update)

    exec "$BIN_DIR/fumetaos-update"
    ;;


config)

    exec "$BIN_DIR/fumetaos-config"
    ;;


help|"")

    exec "$BIN_DIR/fumetaos-help"
    ;;


*)

    echo
    echo "❌ Comando desconocido: $1"
    echo
    echo "Usa:"
    echo
    echo "fumetaos help"
    echo

    exit 1
    ;;


esac
