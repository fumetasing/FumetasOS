#!/bin/bash

###########################################################
# FumetaOS
# Comando principal
###########################################################

###########################################################
# Cargar núcleo FumetaOS
###########################################################

source "$(dirname "$0")/../core/common.sh"


mostrar_help()
{

echo
echo "🖥️ FumetaOS"
echo

echo "Uso:"
echo

echo "fumetaos health"
echo "   Estado completo del sistema"
echo

echo "fumetaos status"
echo "   Estado resumido"
echo

echo "fumetaos report"
echo "   Enviar informe Telegram"
echo

echo "fumetaos doctor"
echo "   Diagnóstico del sistema"
echo

echo "fumetaos version"
echo "   Mostrar versión"
echo

echo "fumetaos app <comando>"
echo "   Gestión de aplicaciones"
echo

echo "fumetaos system <comando>"
echo "   Gestión del sistema"
echo

echo "fumetaos backup"
echo "   Gestión de copias"
echo

echo "fumetaos history"
echo "   Historial del sistema"
echo

echo "fumetaos update"
echo "   Actualizar FumetaOS"
echo

echo "fumetaos config"
echo "   Editar configuración"
echo

echo "fumetaos help"
echo "   Mostrar ayuda"
echo

}


###########################################################
# Ejecutar comandos
###########################################################

case "$1" in

health)

    exec "$BIN_DIR/fumetaos-health"
    ;;


status)

    exec "$BIN_DIR/fumetaos-status"
    ;;


watch)

    exec "$BIN_DIR/fumetaos-watch"
    ;;


report)

    exec "$BIN_DIR/fumetaos-report"
    ;;


doctor)

    exec "$BIN_DIR/fumetaos-doctor"
    ;;


version)

    exec "$BIN_DIR/fumetaos-version"
    ;;


backup)

    shift
    exec "$BIN_DIR/fumetaos-backup" "$@"
    ;;


history)

    shift
    exec "$BIN_DIR/fumetaos-history" "$@"
    ;;


app)

    shift
    exec "$BIN_DIR/fumetaos-app" "$@"
    ;;


system)

    shift
    exec "$BIN_DIR/fumetaos-system" "$@"
    ;;


update)

    exec sudo "$INSTALL_DIR/update.sh" --update
    ;;


config)

    sudo nano "$CONFIG_FILE"
    ;;


help)

    mostrar_help
    ;;


*)

    mostrar_help
    ;;

esac
