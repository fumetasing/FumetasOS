#!/bin/bash

set -euo pipefail

[ "$#" -eq 0 ] ||
  { echo "❌ El verificador no acepta argumentos" >&2; exit 20; }

SERVICIO="fumetaos-docker-firewall.service"
CADENA="FUMETAOS-DOCKER"
LAN="192.168.1.0/24"
INTERFAZ_LAN="br0"

systemctl is-enabled --quiet "$SERVICIO"
systemctl is-active --quiet "$SERVICIO"

iptables -w -C DOCKER-USER -j "$CADENA"
iptables -w -C "$CADENA" \
  -s "$LAN" \
  -i "$INTERFAZ_LAN" \
  -j RETURN
iptables -w -C "$CADENA" \
  -i tailscale0 \
  -j RETURN
iptables -w -C "$CADENA" \
  -i "$INTERFAZ_LAN" \
  -p tcp \
  --dport 51413 \
  -j RETURN
iptables -w -C "$CADENA" \
  -i "$INTERFAZ_LAN" \
  -p udp \
  --dport 51413 \
  -j RETURN
iptables -w -C "$CADENA" \
  -i "$INTERFAZ_LAN" \
  -j DROP
