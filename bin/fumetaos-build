#!/bin/bash

set -euo pipefail

###########################################################
# FumetaOS
# Package Builder
###########################################################

SOURCE="$(cd "$(dirname "$0")/.." && pwd)"

PACKAGE="/opt/fumetaos/install/package"

echo
echo "🏗️ FumetaOS Package Builder"
echo

echo "Origen:"
echo "$SOURCE"

echo

echo "Destino:"
echo "$PACKAGE"

echo

if [ ! -d "$PACKAGE" ]; then

	echo "📁 Creando paquete"

	sudo mkdir -p "$PACKAGE"

fi

# Comprobar fuentes antes de modificar el paquete.
for DIRECTORIO in bin core modules apps config services sudoers; do
  test -d "$SOURCE/$DIRECTORIO" || {
    echo "❌ Falta el directorio: $SOURCE/$DIRECTORIO"
    exit 20
  }
done
for ARCHIVO in install.sh update.sh; do
  bash -n "$SOURCE/install/$ARCHIVO"
done
for REGLA in "$SOURCE/sudoers/"*; do
  test -f "$REGLA"
  sudo visudo -cf "$REGLA"
done

echo "🧹 Limpiando paquete anterior"

sudo rm -rf \
	"$PACKAGE/bin" \
	"$PACKAGE/core" \
	"$PACKAGE/modules" \
	"$PACKAGE/apps" \
	"$PACKAGE/config" \
	"$PACKAGE/services" \
	"$PACKAGE/sudoers"

echo "📦 Copiando bin"

sudo cp -r \
	"$SOURCE/bin" \
	"$PACKAGE/"

echo "📦 Copiando core"

sudo cp -r \
	"$SOURCE/core" \
	"$PACKAGE/"

echo "📦 Copiando módulos"

sudo cp -r \
	"$SOURCE/modules" \
	"$PACKAGE/"

echo "📦 Copiando apps"

sudo cp -r \
	"$SOURCE/apps" \
	"$PACKAGE/"

echo "📦 Copiando servicios"

sudo cp -r \
	"$SOURCE/services" \
	"$PACKAGE/"

echo "📦 Copiando configuración"

sudo cp -r \
	"$SOURCE/config" \
	"$PACKAGE/"

echo "🔐 Copiando permisos limitados"
sudo cp -r "$SOURCE/sudoers" "$PACKAGE/"
sudo chown -R root:root "$PACKAGE/sudoers"
sudo find "$PACKAGE/sudoers" -type d -exec chmod 755 {} +
sudo find "$PACKAGE/sudoers" -type f -exec chmod 440 {} +

echo "📦 Copiando instaladores"
for ARCHIVO in install.sh update.sh; do
  sudo install -D -o root -g root -m 755 \
    "$SOURCE/install/$ARCHIVO" "$PACKAGE/install/$ARCHIVO"
done

echo "🏷️ Copiando versión"

sudo cp \
	"$SOURCE/VERSION" \
	"$PACKAGE/VERSION"

echo

echo "🔒 Ajustando permisos"

sudo chmod -R 755 "$PACKAGE/bin"
sudo chmod -R 755 "$PACKAGE/core"
sudo chmod -R 755 "$PACKAGE/modules"
sudo chmod -R 755 "$PACKAGE/apps"
sudo find "$PACKAGE/services" -type d -exec chmod 755 {} +
sudo find "$PACKAGE/services" -type f -exec chmod 644 {} +

echo

echo "✅ Paquete generado correctamente"

echo

ls -la "$PACKAGE"

echo
