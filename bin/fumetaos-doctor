#!/bin/bash

source "$(dirname "$0")/../core/common.sh"
source "$CORE_DIR/apps.sh"

PUNTOS=0
TOTAL=0

PACKAGE_DIR="/opt/fumetaos/install/package"

if [ -d "$INSTALL_DIR/package" ]; then
	PACKAGE_DIR="$INSTALL_DIR/package"
fi

check() {
	DESCRIPCION="$1"
	shift

	TOTAL=$((TOTAL + 1))

	if "$@"; then
		echo "✅ $DESCRIPCION"
		PUNTOS=$((PUNTOS + 1))
	else
		echo "❌ $DESCRIPCION"
	fi
}

firewall_active() {
	sudo ufw status 2>/dev/null |
		grep -q "Status: active"
}

casaos_journal_access() {
	[ -x /opt/fumetaos/bin/fumetaos-casaos-journal ] &&
		sudo -n /opt/fumetaos/bin/fumetaos-casaos-journal >/dev/null 2>&1
}

docker_firewall_active() {
	[ -x /opt/fumetaos/bin/fumetaos-docker-firewall-status ] &&
		sudo -n /opt/fumetaos/bin/fumetaos-docker-firewall-status >/dev/null 2>&1
}

nightly_chain_configured() {
	local timer

	[ -x /opt/fumetaos/bin/fumetaos-nightly ] || return 1
	[ -x /opt/fumetaos/bin/fumetaos-smart-test ] || return 1
	systemctl is-enabled --quiet fumetaos-nightly.timer || return 1
	systemctl is-active --quiet fumetaos-nightly.timer || return 1
	systemctl cat fumetaos-nightly.timer 2>/dev/null |
		grep -Fqx 'OnCalendar=*-*-* 00:30:00' || return 1
	[ -z "$(systemctl show fumetaos-timecapsule-mac-backup.service -p OnSuccess --value)" ] || return 1

	for timer in \
		fumetaos-backup.timer \
		fumetaos-timecapsule-mac-backup.timer \
		fumetaos-mac-backup.timer \
		fumetaos-recovery-backup.timer \
		fumetaos-recovery-verify.timer \
		fumetaos-system-upgrade.timer \
		fumetaos-smart-test.timer; do
		if systemctl is-enabled --quiet "$timer" ||
			systemctl is-active --quiet "$timer"; then
			return 1
		fi
	done

	return 0
}

ubuntu_automatic_timers_disabled() {
	local timer

	for timer in apt-daily.timer apt-daily-upgrade.timer; do
		if systemctl is-enabled --quiet "$timer" ||
			systemctl is-active --quiet "$timer"; then
			return 1
		fi
	done

	return 0
}

backup_disponible() {
	find /mnt/datos/backups/fumetaos \
		-maxdepth 1 \
		-type f \
		-name 'fumetaos-backup-*' \
		-print \
		-quit \
		2>/dev/null |
		grep -q .
}

echo
echo "🩺 FumetaOS Doctor"
echo

echo "📁 Sistema"
echo

check "Configuración" test -f "$CONFIG_FILE"
check "Versión" test -f "$VERSION_FILE"
check "Scripts ejecutables" test -x "$BIN_DIR/fumetaos"

echo
echo "🔧 Configuración"
echo

check "Telegram configurado" test -n "$TELEGRAM_TOKEN"
check "SSD configurado" test -n "$SSD_DEVICE"
check "HDD configurado" test -n "$HDD_DEVICE"

echo
echo "🔒 Seguridad"
echo

check "Firewall UFW" firewall_active
check "Protección Docker" docker_firewall_active
check "Registro CasaOS" casaos_journal_access

echo
echo "⚙️ Servicios"
echo

check "Docker" systemctl is-active --quiet docker
check "CasaOS" systemctl is-active --quiet casaos
check "Tailscale" systemctl is-active --quiet tailscaled
check "No-IP DUC" systemctl is-active --quiet noip-duc
check "SSH" systemctl is-active --quiet ssh

echo
echo "⏱️ Timers FumetaOS"
echo

for TIMER in $FUMETAOS_TIMERS; do
	check "$TIMER" systemctl is-active --quiet "$TIMER"
done

check "Cadena nocturna de copias y actualización (00:30)" nightly_chain_configured
check "Actualizaciones automáticas de Ubuntu fuera de la cadena desactivadas" ubuntu_automatic_timers_disabled

echo
echo "📦 Aplicaciones"
echo

for APP in $(app_list); do
	app_load "$APP"

	TOTAL=$((TOTAL + 1))

	if app_running; then
		echo "✅ $APP_NAME"
		PUNTOS=$((PUNTOS + 1))
	else
		echo "❌ $APP_NAME"
	fi
done

echo
echo "📦 Paquete"
echo

check "Paquete VERSION" test -f "$PACKAGE_DIR/VERSION"
check "Paquete bin" test -d "$PACKAGE_DIR/bin"
check "Paquete core" test -d "$PACKAGE_DIR/core"
check "Paquete modules" test -d "$PACKAGE_DIR/modules"
check "Paquete services" test -d "$PACKAGE_DIR/services"
check "Paquete sudoers" test -d "$PACKAGE_DIR/sudoers"

echo
echo "💾 Datos"
echo

check "Backup disponible" backup_disponible
check "Histórico funcionando" test -s "$DATA_DIR/history.log"

echo
echo "Resultado: $PUNTOS/$TOTAL"
echo

# Resultado utilizable por otros programas.
if [ "$PUNTOS" -eq "$TOTAL" ]; then
  exit 0
fi

exit 20
