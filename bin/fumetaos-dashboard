#!/bin/bash

###########################################################
# FumetaOS Dashboard
###########################################################

source /opt/fumetaos/core/common.sh
source /opt/fumetaos/core/system.sh

CPU=$(cpu_temp)
RAM=$(ram_usage)
DISCO=$(disk_usage)
UPDATES=$(updates_available)

if /opt/fumetaos/bin/fumetaos-health >/dev/null 2>&1
then
    ESTADO="🟢 PERFECTO"
else
    RET=$?

    if [ "$RET" -eq 10 ]; then
        ESTADO="🟡 AVISOS"
    else
        ESTADO="🔴 REVISAR"
    fi
fi

echo
echo "🖥️ FumetaOS $FUMETAOS_VERSION"
echo

echo "Estado: $ESTADO"
echo
echo "💾 Disco: ${DISCO}%"
echo "🧠 RAM:   ${RAM}%"
echo "🌡️ CPU:   ${CPU}°C"
echo "📦 Actualizaciones: ${UPDATES}"
echo

echo "Comandos"
echo "────────"
echo "health    Estado completo"
echo "status    Estado rápido"
echo "doctor    Diagnóstico"
echo "report    Informe Telegram"
echo "version   Información"
echo "config    Configuración"

echo
echo "Mac mini Late 2012"
echo "$(. /etc/os-release && echo "$PRETTY_NAME")"
echo
