#!/bin/bash

###########################################################
# FumetaOS Dashboard v3.1
# Terminal Console
###########################################################

source /opt/fumetaos/core/common.sh
source /opt/fumetaos/core/system.sh
source /opt/fumetaos/core/apps.sh


WIDTH=42
INNER=40


VERSION="desconocida"

if [ -f "$VERSION_FILE" ]; then
    VERSION=$(cat "$VERSION_FILE")
fi


###########################################################
# Caja
###########################################################

line()
{
    printf '═%.0s' $(seq 1 $INNER)
}


top()
{
    echo "╔$(line)╗"
}


bottom()
{
    echo "╚$(line)╝"
}


separator()
{
    echo "╠$(line)╣"
}


box()
{
    TEXT="$1"

    printf "║ %-38s ║\n" "$TEXT"
}


###########################################################
# Datos
###########################################################

CPU=$(cpu_temp)
RAM=$(ram_usage)

SYSTEM_DISK=$(df / | awk 'NR==2 {gsub("%","",$5);print $5}')

DATA_DISK=$(disk_usage)

UPDATES=$(updates_available)


if /opt/fumetaos/bin/fumetaos-health >/dev/null 2>&1
then
    STATUS="PERFECTO"
else
    STATUS="AVISOS"
fi


###########################################################
# Render
###########################################################

top


box "FumetaOS v$VERSION"


separator


box "ESTADO: $STATUS"


separator


box "RECURSOS"

box "CPU:              ${CPU} C"

box "RAM:              ${RAM} %"

box "SISTEMA:          ${SYSTEM_DISK} %"



separator


box "APLICACIONES"


for APP in $(app_list)
do

    app_load "$APP"


    if app_running
    then
        ICON="[OK]"
    else
        ICON="[--]"
    fi


    box "$ICON $APP_NAME"

    box "     Version: $APP_VERSION"

    box "     Health: $(app_health)"

done



separator


box "SERVICIOS"


for SERVICE in docker ssh tailscaled
do

    if systemctl is-active --quiet "$SERVICE"
    then
        box "[OK] $SERVICE"
    else
        box "[--] $SERVICE"
    fi

done



separator


box "ALMACENAMIENTO"


box "SSD Sistema: ${SYSTEM_DISK} %"

box "HDD Datos:   ${DATA_DISK} %"



separator


box "ACTUALIZACIONES: $UPDATES"


bottom
