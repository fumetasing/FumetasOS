#!/bin/bash

###########################################################
# FumetaOS
# System Manager
###########################################################

source "$(dirname "$0")/../core/common.sh"


mostrar_version()
{

echo
echo "🖥️ FumetaOS"
echo

if [ -f "$VERSION_FILE" ]; then
    echo "Versión: $(cat "$VERSION_FILE")"
else
    echo "Versión: desconocida"
fi

echo "Kernel: $(uname -r)"

echo "Uptime: $(uptime -p | sed 's/up //')"

echo

}


mostrar_status()
{

echo
echo "🖥️ Estado del sistema"
echo

echo "Versión: $(cat "$VERSION_FILE" 2>/dev/null)"
echo "Kernel: $(uname -r)"
echo "Uptime: $(uptime -p | sed 's/up //')"

echo

}


mostrar_update()
{

echo
echo "🔄 FumetaOS Update"
echo

if [ -f "$VERSION_FILE" ]; then

    echo "Versión instalada: $(cat "$VERSION_FILE")"

else

    echo "Versión instalada: desconocida"

fi

echo
echo "Sistema de actualización disponible:"
echo
echo "   fumetaos update"
echo

echo "Este comando realiza:"
echo "   💾 Backup previo"
echo "   📦 Instalación del paquete"
echo "   ⚙️ Actualización de servicios"
echo "   🩺 Comprobación del sistema"

echo

}


mostrar_help()
{

echo
echo "🖥️ FumetaOS System"
echo

echo "Uso:"
echo

echo "fumetaos system version"
echo "   Mostrar versión del sistema"
echo

echo "fumetaos system status"
echo "   Estado del sistema"
echo

echo "fumetaos system update"
echo "   Información de actualización"
echo

echo "fumetaos system help"
echo "   Mostrar ayuda"
echo

}


case "$1" in

version)

    mostrar_version
    ;;


status)

    mostrar_status
    ;;


update)

    mostrar_update
    ;;


help|"")

    mostrar_help
    ;;


*)

    mostrar_help
    ;;

esac
