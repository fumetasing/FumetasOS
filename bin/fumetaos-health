#!/bin/bash

###########################################################
# FumetaOS
# Health
###########################################################

source "$(dirname "$0")/../core/common.sh"

ERROR=0
TELEGRAM=0
CHECK_ONLY=0

case "${1:-}" in
"") ;;
--telegram)
	TELEGRAM=1
	;;
--check)
	CHECK_ONLY=1
	;;
*)
	echo "Uso: $0 [--telegram|--check]" >&2
	exit 20
	;;
esac

if [ -f "$VERSION_FILE" ]; then
	FUMETAOS_VERSION="$(<"$VERSION_FILE")"
else
	FUMETAOS_VERSION="desconocida"
fi

separator() {
	echo "━━━━━━━━━━━━━━━━"
}

registrar_resultado() {
	local status="$1"

	if [ "$status" -gt "$ERROR" ]; then
		ERROR="$status"
	fi
}

ejecutar_seccion() {
	local title="$1"
	local script="$2"
	local status

	if [ "$TELEGRAM" -eq 1 ]; then
		separator
	else
		echo
	fi

	echo "$title"

	"$script"
	status=$?

	registrar_resultado "$status"
}

comprobar_silenciosamente() {
	local script
	local status
	local pid
	local -a scripts
	local -a pids

	scripts=(
		/opt/fumetaos/modules/monitor/services.sh
		/opt/fumetaos/modules/monitor/timecapsule.sh
		/opt/fumetaos/modules/monitor/security.sh
		/opt/fumetaos/modules/monitor/timers.sh
		/opt/fumetaos/modules/monitor/backups.sh
		/opt/fumetaos/modules/monitor/smart.sh
		/opt/fumetaos/modules/monitor/disks.sh
		/opt/fumetaos/modules/monitor/temperature.sh
		/opt/fumetaos/modules/monitor/memory.sh
		/opt/fumetaos/modules/monitor/virtual-machines.sh
		/opt/fumetaos/modules/monitor/apps.sh
		/opt/fumetaos/modules/monitor/updates.sh
	)

	for script in "${scripts[@]}"; do
		"$script" >/dev/null 2>&1 &
		pids+=("$!")
	done

	for pid in "${pids[@]}"; do
		status=0
		wait "$pid" || status=$?
		registrar_resultado "$status"
	done

	if [ -f /var/run/reboot-required ]; then
		status=0
		/opt/fumetaos/modules/monitor/reboot.sh >/dev/null 2>&1 || status=$?
		registrar_resultado "$status"
	fi

	exit "$ERROR"
}

if [ "$CHECK_ONLY" -eq 1 ]; then
	comprobar_silenciosamente
fi

if [ "$TELEGRAM" -eq 1 ]; then
	echo "🖥️ FumetaOS DAILY REPORT"
	separator

	echo
	echo "🖥️ FumetaOS v$FUMETAOS_VERSION"

	echo
	echo "🖥️ Sistema"
	/opt/fumetaos/modules/monitor/system.sh

else
	echo
	echo "🖥️ FumetaOS v$FUMETAOS_VERSION"

	echo
	echo "🖥️ Sistema"
	/opt/fumetaos/modules/monitor/system.sh
fi

ejecutar_seccion \
	"🛠️ Servicios" \
	/opt/fumetaos/modules/monitor/services.sh

ejecutar_seccion \
	"💾 Time Capsule" \
	/opt/fumetaos/modules/monitor/timecapsule.sh

ejecutar_seccion \
	"🔒 Seguridad" \
	/opt/fumetaos/modules/monitor/security.sh

ejecutar_seccion \
	"⏱️ Timers FumetaOS" \
	/opt/fumetaos/modules/monitor/timers.sh

ejecutar_seccion \
	"💾 Copias de seguridad" \
	/opt/fumetaos/modules/monitor/backups.sh

ejecutar_seccion \
	"💚 SMART" \
	/opt/fumetaos/modules/monitor/smart.sh

ejecutar_seccion \
	"💾 Discos" \
	/opt/fumetaos/modules/monitor/disks.sh

ejecutar_seccion \
	"🌡️ Temperatura" \
	/opt/fumetaos/modules/monitor/temperature.sh

ejecutar_seccion \
	"🧠 Memoria" \
	/opt/fumetaos/modules/monitor/memory.sh

ejecutar_seccion \
	"🖥️ Máquinas virtuales" \
	/opt/fumetaos/modules/monitor/virtual-machines.sh

ejecutar_seccion \
	"📦 Aplicaciones" \
	/opt/fumetaos/modules/monitor/apps.sh

if [ "$TELEGRAM" -eq 1 ]; then
	separator
else
	echo
fi

echo "📦 Actualizaciones"

/opt/fumetaos/modules/monitor/updates.sh
registrar_resultado "$?"

if [ -f /var/run/reboot-required ]; then
	/opt/fumetaos/modules/monitor/reboot.sh
	registrar_resultado "$?"
fi

if [ "$TELEGRAM" -eq 1 ]; then
	separator
fi

echo

case "$ERROR" in
0)
	echo "🟢 Estado general: PERFECTO"
	;;
10)
	echo "🟡 Estado general: AVISOS"
	;;
*)
	echo "🔴 Estado general: REVISAR"
	;;
esac

exit "$ERROR"
