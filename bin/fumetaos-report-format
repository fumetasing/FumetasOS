#!/bin/bash

###########################################################
# FumetaOS
# Daily Report Formatter
###########################################################

SEPARATOR="━━━━━━━━━━━━━━━━"

echo "🖥️ FumetaOS DAILY REPORT"
echo "$SEPARATOR"

while IFS= read -r line; do
	case "$line" in
	"🖥️ FumetaOS v"*)
		echo "$line"
		echo
		;;

	"🖥️ Sistema")
		echo "$line"
		echo
		;;

	"🛠️ Servicios" | \
		"💾 Time Capsule" | \
		"🔒 Seguridad" | \
		"⏱️ Timers FumetaOS" | \
		"💾 Copias de seguridad" | \
		"💚 SMART" | \
		"💾 Discos" | \
		"🌡️ Temperatura" | \
		"🧠 Memoria" | \
		"🖥️ Máquinas virtuales" | \
		"📦 Aplicaciones" | \
		"📦 Actualizaciones")
		echo "$SEPARATOR"
		echo "$line"
		;;

	"🟢 Estado general:"* | \
		"🟡 Estado general:"* | \
		"🔴 Estado general:"*)
		echo "$SEPARATOR"
		echo
		echo "$line"
		;;

	"") ;;

	*)
		echo "$line"
		;;
	esac
done
