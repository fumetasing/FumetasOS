#!/bin/bash

############################################################

# FumetaOS

# Daily Report Formatter

############################################################


SEPARATOR="━━━━━━━━━━━━━━━━"


FIRST_LINE=1


while IFS= read -r LINE
do


case "$LINE" in


"🖥️ FumetaOS DAILY REPORT")

    if [ "$FIRST_LINE" -eq 1 ]; then

        echo "$LINE"
        FIRST_LINE=0

    fi

    ;;


"━━━━━━━━━━━━━━━━")

    echo "$LINE"

    ;;


"🖥️ FumetaOS v"*)

    echo
    echo "$LINE"
    echo

    ;;


"🛠️ Servicios"|"🔒 Seguridad"|"⏱️ Timers FumetaOS"|"💚 SMART"|"💾 Discos"|"🌡️ Temperatura"|"🧠 Memoria"|"📦 Aplicaciones"|"📦 Actualizaciones")

    echo
    echo "$SEPARATOR"
    echo "$LINE"

    ;;


"🟢 Estado general:"*)

    echo
    echo "$SEPARATOR"
    echo
    echo "$LINE"

    ;;


"")

    ;;


*)

    echo "$LINE"

    ;;


esac


done
