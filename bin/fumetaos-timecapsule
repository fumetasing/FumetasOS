#!/bin/bash

set -euo pipefail

MOUNTPOINT="/mnt/timecapsule"
CREDENTIAL_FILE="/etc/fumetaos/timecapsule-smb-credentials"

SMB_USERNAME="admin"
SMB_HOST="192.168.1.2"
SMB_SHARE="Data"
SMB_VERSION="3.1.1"
MOUNT_CIFS="/usr/sbin/mount.cifs"

mostrar_error() {
	echo "❌ $1"
	exit 20
}

requiere_root() {
	[ "$(id -u)" -eq 0 ] ||
		mostrar_error "Esta acción debe ejecutarse como root"
}

esta_montado() {
	findmnt -rn -M "$MOUNTPOINT" >/dev/null 2>&1
}

es_montaje_smb() {
	[ "$(findmnt -rn -M "$MOUNTPOINT" -o FSTYPE 2>/dev/null)" = "cifs" ]
}

cliente_instalado() {
	[ -x "$MOUNT_CIFS" ]
}

instalar_cliente() {
	requiere_root

	if cliente_instalado; then
		echo "✅ Cliente SMB ya instalado"
		echo "   $MOUNT_CIFS"
		exit 0
	fi

	command -v apt-get >/dev/null 2>&1 ||
		mostrar_error "APT no está disponible"

	echo "📦 Instalando cliente SMB"
	export DEBIAN_FRONTEND=noninteractive
	apt-get update
	apt-get install --yes cifs-utils

	cliente_instalado ||
		mostrar_error "El cliente SMB no se instaló correctamente"

	echo "✅ Cliente SMB instalado correctamente"
}

mostrar_estado() {
	echo "💾 Time Capsule SMB"
	echo "   Servidor: $SMB_HOST"
	echo "   Recurso: $SMB_SHARE"
	echo "   Protocolo: SMB $SMB_VERSION"
	echo "   Punto interno: $MOUNTPOINT"
	echo "   Punto CasaOS: /DATA/TimeCapsule"

	if cliente_instalado; then
		echo "✅ Cliente SMB instalado"
	else
		echo "❌ Cliente SMB no instalado"
	fi

	if es_montaje_smb; then
		echo "✅ Time Capsule montada mediante SMB"
	elif esta_montado; then
		echo "🔴 El punto está ocupado por un montaje que no es SMB"
	else
		echo "🟡 Time Capsule no montada"
	fi
}

montar() {
	local SERVER_UID
	local SERVER_GID

	requiere_root

	[ -r "$CREDENTIAL_FILE" ] ||
		mostrar_error "No se pueden leer las credenciales SMB de la Time Capsule"

	[ "$(stat -c '%a' "$CREDENTIAL_FILE")" = "600" ] ||
		mostrar_error "Las credenciales SMB deben tener permisos 600"

	cliente_instalado ||
		mostrar_error "El cliente SMB no está instalado. Ejecuta: fumetaos-timecapsule install-client"

	install -d \
		-o server \
		-g server \
		-m 0750 \
		"$MOUNTPOINT"

	if es_montaje_smb; then
		echo "✅ Time Capsule ya montada mediante SMB: $MOUNTPOINT"
		exit 0
	fi

	if esta_montado; then
		mostrar_error "El punto $MOUNTPOINT está ocupado por un montaje que no es SMB"
	fi

	SERVER_UID="$(id -u server)"
	SERVER_GID="$(id -g server)"

	echo "💾 Montando Time Capsule mediante SMB $SMB_VERSION en $MOUNTPOINT"

	/usr/bin/mount \
		-t cifs \
		"//$SMB_HOST/$SMB_SHARE" \
		"$MOUNTPOINT" \
		-o "credentials=$CREDENTIAL_FILE,vers=$SMB_VERSION,uid=$SERVER_UID,gid=$SERVER_GID,forceuid,forcegid,file_mode=0666,dir_mode=0777,iocharset=utf8,noserverino"

	es_montaje_smb ||
		mostrar_error "El montaje SMB no se completó"

	timeout 30 ls "$MOUNTPOINT" >/dev/null 2>&1 ||
		mostrar_error "La Time Capsule se montó pero no responde"

	echo "✅ Time Capsule montada correctamente mediante SMB"
}

desmontar() {
	requiere_root

	if ! esta_montado; then
		echo "ℹ️ Time Capsule no estaba montada"
		exit 0
	fi

	echo "🔌 Desmontando Time Capsule"
	/usr/bin/umount "$MOUNTPOINT"
	echo "✅ Time Capsule desmontada"
}

case "${1:-}" in
install-client)
	instalar_cliente
	;;
status)
	mostrar_estado
	;;
mount)
	montar
	;;
unmount)
	desmontar
	;;
*)
	echo "Uso:"
	echo "fumetaos-timecapsule install-client"
	echo "fumetaos-timecapsule status"
	echo "fumetaos-timecapsule mount"
	echo "fumetaos-timecapsule unmount"
	exit 20
	;;
esac
