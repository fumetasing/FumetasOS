#!/bin/bash

set -euo pipefail

SOURCE_DIR="/mnt/datos/"
MAC_USER="fumetasing"
MAC_HOST="192.168.1.5"
MAC_ROOT="/Users/fumetasing/FumetaOS-Server"
MAC_DESTINATION="$MAC_ROOT"
MAC_USB_MOUNT="/Volumes/Data USB"

MINIMUM_FREE_KB=$((50 * 1024 * 1024))
DELETE_LIMIT=50
# FUMETAOS_DAILY_DELETE_50_PS4_V1
MAX_RETRIES=3
RETRY_DELAY=60

SSH_KEY="/home/server/.ssh/id_ed25519_fumetaos_mac"
SSH_KNOWN_HOSTS="/home/server/.ssh/known_hosts"
LOCK_FILE="/run/lock/fumetaos-mac-backup.lock"
TELEGRAM_NOTIFY="/opt/fumetaos/bin/telegram-notify"

DRY_RUN=()
ALLOW_LARGE_DELETE=0
CURRENT_STEP="Preparación"

RSYNC_FILTER_OPTIONS=(
	--exclude='/lost+found/'
	--exclude='/TimeCapsule/'
	--filter='P /TimeCapsule/***'
)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/../core/mac-mirror-common.sh"

mostrar_error() {
	echo "❌ $1"
	exit 20
}

notificar_error() {
	local status="$1"

	mac_mirror_enviar_telegram "🔴 FumetaOS ERROR

La copia de datos al Mac ha fallado.

Paso: $CURRENT_STEP
Código: $status

⏱️ $(date '+%d/%m/%Y %H:%M')"
}

manejar_error() {
	local status="$?"

	trap - ERR

	if [ "$status" -eq 25 ]; then
		if [ "${#DRY_RUN[@]}" -gt 0 ]; then
			echo "ℹ️ Simulación: se superaría el cupo de borrados; no se ha cambiado nada."
			exit 25
		fi
		echo "⚠️ Espejo parcial: se alcanzó el cupo de borrados. Pendientes para el próximo día con cupo disponible."
		mac_mirror_enviar_telegram "🟡 FumetaOS: espejo al Mac pendiente. Cupo diario de 50 borrados fuera de PS4 & PS5 alcanzado; continúa con el cupo del próximo día. No se da por completa esta ejecución." || true
		exit 25
	fi

	echo
	echo "🔴 La copia de datos al Mac ha fallado en: $CURRENT_STEP"

	notificar_error "$status"

	exit "$status"
}

comprobar_borrados_previstos() {
	echo "ℹ️ Se aplicará el cupo persistente de 50 borrados diarios fuera de PS4 & PS5."
}

fumetaos_cupo_diario() {
	python3 - "$1" "$2" <<'FUMETAOS_CONTADOR'
import datetime
import json
import os
from pathlib import Path
import stat
import sys
import tempfile

folder = Path('/var/lib/fumetaos-mac-delete-budget')
if sys.argv[2] == 'reserve':
    folder.mkdir(mode=0o700, exist_ok=True)
if folder.exists() or folder.is_symlink():
    info = folder.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o700:
        raise RuntimeError('Directorio del contador inseguro; no se autorizan borrados.')
path = folder / 'contador.json'
today = datetime.date.today().isoformat()
state = {'day': today, 'used': 0}
if path.exists() or path.is_symlink():
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o600:
        raise RuntimeError('Archivo del contador inseguro.')
    state = json.loads(path.read_text())
    if (set(state) != {'day', 'used'} or type(state['used']) is not int
            or not 0 <= state['used'] <= 50
            or datetime.date.fromisoformat(state['day']).isoformat() != state['day']):
        raise RuntimeError('Contador no válido; no se reinicia automáticamente.')
    if state['day'] > today:
        raise RuntimeError('El reloj ha retrocedido; no se renueva el cupo.')
    if state['day'] < today:
        state = {'day': today, 'used': 0}
requested = int(sys.argv[1])
if requested < 0:
    raise RuntimeError('Número previsto no válido.')
quota = min(requested, 50 - state['used'])
if sys.argv[2] == 'reserve':
    # Reservar ANTES de rsync: una interrupción/reinicio no concede otro cupo.
    state['used'] += quota
    fd, name = tempfile.mkstemp(prefix='.contador-', dir=folder)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(state, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
        directory = os.open(folder, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(name):
            os.unlink(name)
elif sys.argv[2] != 'inspect':
    raise RuntimeError('Operación del contador no válida.')
print(quota)
FUMETAOS_CONTADOR
}

ejecutar_rsync_con_reintentos() {
	local status=0 deletes quota mode
	local otros=("${RSYNC_FILTER_OPTIONS[@]}" --exclude='/PS4 & PS5/' --filter='P /PS4 & PS5/***')
	CURRENT_STEP="Validación del USB y de PS4 & PS5"
	mac_mirror_usb_disponible || mostrar_error "USB no disponible o no validado"
	[ -d "${SOURCE_DIR%/}/PS4 & PS5" ] && [ ! -L "${SOURCE_DIR%/}/PS4 & PS5" ] ||
		mostrar_error "La carpeta original PS4 & PS5 no es un directorio real; no se copia ni borra nada"
	CURRENT_STEP="Contar borrados fuera de PS4 & PS5"
	deletes="$(mac_mirror_contar_borrados "$SOURCE_DIR" "$MAC_USER@$MAC_HOST:$MAC_DESTINATION/" "${otros[@]}")" || return "$?"
	case "$deletes" in ''|*[!0-9]*) mostrar_error "No se pudo contar los borrados" ;; esac
	mode=reserve
	[ "${#DRY_RUN[@]}" -eq 0 ] || mode=inspect
	quota="$(fumetaos_cupo_diario "$deletes" "$mode")" || return "$?"
	case "$quota" in ''|*[!0-9]*) mostrar_error "Cupo no válido" ;; esac
	echo "🛡️ Cupo disponible para esta transferencia: $quota. Máximo diario: 50; PS4 & PS5 exenta."
	# Una sola transferencia por grupo, nunca reintentar borrados automáticamente.
	CURRENT_STEP="Copia de PS4 & PS5 sin límite de borrados"
	mac_mirror_usb_disponible || mostrar_error "USB no disponible o no validado"
	if mac_mirror_copiar "${SOURCE_DIR%/}/PS4 & PS5/" "$MAC_USER@$MAC_HOST:$MAC_DESTINATION/PS4 & PS5/"; then
		:
	else
		return "$?"
	fi
	CURRENT_STEP="Copia del resto del espejo, cupo diario de borrados"
	mac_mirror_usb_disponible || mostrar_error "USB no disponible o no validado"
	if mac_mirror_copiar "$SOURCE_DIR" "$MAC_USER@$MAC_HOST:$MAC_DESTINATION/" "${otros[@]}" "--max-delete=$quota"; then
		return 0
	else
		status="$?"
		return "$status"
	fi
}

case "${1:-}" in
"") ;;
--dry-run)
	DRY_RUN=(--dry-run)
	;;
--allow-large-delete)
	echo "ℹ️ --allow-large-delete no elimina el máximo diario de 50 fuera de PS4 & PS5."
	ALLOW_LARGE_DELETE=0
	;;
*)
	echo "Uso:"
	echo "fumetaos-mac-backup"
	echo "fumetaos-mac-backup --dry-run"
	echo "fumetaos-mac-backup --allow-large-delete"
	exit 20
	;;
esac

[ "$(id -u)" -eq 0 ] ||
	mostrar_error "Esta copia debe ejecutarse como root"

[ -d "$SOURCE_DIR" ] ||
	mostrar_error "No existe el origen: $SOURCE_DIR"

mountpoint -q /mnt/datos ||
	mostrar_error "/mnt/datos no está montado"

[ -r "$SSH_KEY" ] ||
	mostrar_error "No existe la clave SSH: $SSH_KEY"

[ -r "$SSH_KNOWN_HOSTS" ] ||
	mostrar_error "No existe el archivo de hosts SSH conocidos: $SSH_KNOWN_HOSTS"

exec 9>"$LOCK_FILE"

flock -n 9 ||
	mostrar_error "Ya hay una copia al Mac en curso"

mac_mirror_crear_ssh_command

trap manejar_error ERR

echo "💾 Copia espejo de /mnt/datos al Mac"
echo "📍 Destino: $MAC_DESTINATION"
echo "🛡️ Límite diario fuera de PS4 & PS5: $DELETE_LIMIT"
echo "ℹ️ Dos grupos: PS4 & PS5 exenta y resto limitado; sin reintentos automáticos."
echo

CURRENT_STEP="Comprobación inicial del Mac y del disco USB"

mac_mirror_usb_disponible ||
	mostrar_error "El USB del Mac no está listo, no es el disco esperado o tiene menos de 50 GiB libres"

"${SSH_COMMAND[@]}" \
	"$MAC_USER@$MAC_HOST" \
	"test -d '$MAC_DESTINATION'" ||
	mostrar_error "El Mac o el disco USB no están disponibles"

if [ "${#DRY_RUN[@]}" -eq 0 ] &&
	[ "$ALLOW_LARGE_DELETE" -eq 0 ]; then
	CURRENT_STEP="Comprobación de borrados previstos"
	comprobar_borrados_previstos
fi

ejecutar_rsync_con_reintentos

trap - ERR

echo

if [ "${#DRY_RUN[@]}" -gt 0 ]; then
	echo "✅ Simulación completada: no se ha copiado ni borrado nada"
else
	echo "✅ Copia espejo completada"
fi
