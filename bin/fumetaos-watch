#!/bin/bash

###########################################################
# FumetaOS
# Watch
###########################################################

source "$(dirname "$0")/../core/common.sh"
source "$CORE_DIR/watch.sh"


mostrar_help()
{

echo

echo "👁️ FumetaOS Watch"

echo

echo "Uso:"
echo

echo "fumetaos watch run"
echo "   Ejecutar comprobación del sistema"

echo

echo "fumetaos watch help"
echo "   Mostrar ayuda"

echo

}



watch_execute()
{

echo

echo "👁️ FumetaOS Watch"

echo

echo "🔎 Comprobando sistema..."

echo


watch_run


echo

echo "✅ Comprobación completada"

echo

}



case "$1" in


run)

    watch_execute
    ;;


help|"")

    mostrar_help
    ;;


*)

    mostrar_help
    ;;


esac
