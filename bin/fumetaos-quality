#!/bin/bash

###########################################################
# FumetaOS
# Verificación global de calidad del código
###########################################################

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

if [ "$#" -ne 0 ]; then
	echo "Uso: $(basename "$0")"
	exit 20
fi

for COMMAND in bash shellcheck shfmt git find sort; do
	if ! command -v "$COMMAND" >/dev/null 2>&1; then
		echo "❌ Falta la herramienta requerida: $COMMAND"
		exit 20
	fi
done

cd "$PROJECT_DIR"

mapfile -d '' CHECK_FILES < <(
	find bin core modules apps install \
		-type f \
		\( -name '*.sh' -o -path 'bin/*' \) \
		-print0 |
		sort -z
)

echo "🧪 FumetaOS Quality"
echo

echo "===== SINTAXIS ====="

for FILE in "${CHECK_FILES[@]}"; do
	bash -n "$FILE"
done

echo "✅ Sintaxis correcta"

echo
echo "===== SHELLCHECK ====="

shellcheck \
	--shell=bash \
	--severity=warning \
	"${CHECK_FILES[@]}"

echo "✅ Sin avisos importantes"

echo
echo "===== FORMATO ====="

shfmt -d "${CHECK_FILES[@]}"

echo "✅ Formato uniforme"

echo
echo "===== GIT ====="

git diff --check

echo "✅ Sin errores de espacios"

echo
echo "✅ Calidad global de FumetaOS verificada"
