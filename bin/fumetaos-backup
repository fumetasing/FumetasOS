#!/bin/bash
set -euo pipefail

DATA_DIR="/mnt/datos/backups/fumetaos"
SYSTEM_DIR="/var/backups/fumetaos"
BASE="/opt/fumetaos"
PREFIX="fumetaos-backup-"
DAILY_KEEP=14
WEEKLY_KEEP=8
BIWEEKLY_KEEP=6
MONTHLY_KEEP=12

TEMP=""
ARCHIVE=""

cleanup_temp() {
    [ -n "$TEMP" ] && rm -rf "$TEMP"
    [ -n "$ARCHIVE" ] && rm -f "$ARCHIVE"
}
trap cleanup_temp EXIT

prepare_dirs() {
    mkdir -p "$DATA_DIR" "$SYSTEM_DIR"
}

copy_source() {
    TEMP=$(mktemp -d /tmp/fumetaos-backup.XXXXXX)

    cp -rL "$BASE/config" "$TEMP/"
    cp -rL "$BASE/bin" "$TEMP/"
    cp -rL "$BASE/core" "$TEMP/"
    cp -rL "$BASE/modules" "$TEMP/"

    mkdir -p "$TEMP/services"
    cp /etc/systemd/system/fumetaos-*.service "$TEMP/services/" 2>/dev/null || true
    cp /etc/systemd/system/fumetaos-*.timer "$TEMP/services/" 2>/dev/null || true
    cp -L "$BASE/VERSION" "$TEMP/"
}

create_backup() {
    local date file data_file system_file data_sum system_sum

    prepare_dirs
    date=$(date +"%Y-%m-%d_%H-%M")
    file="${PREFIX}${date}.tar.gz"
    data_file="$DATA_DIR/$file"
    system_file="$SYSTEM_DIR/$file"

    echo "📦 Preparando copia real de FumetaOS"
    copy_source

    ARCHIVE=$(mktemp /tmp/fumetaos-backup-archive.XXXXXX)
    tar -czf "$ARCHIVE" -C "$TEMP" .
    gzip -t "$ARCHIVE"

    install -m 0640 "$ARCHIVE" "$data_file"
    install -m 0640 "$ARCHIVE" "$system_file"

    data_sum=$(sha256sum "$data_file" | awk '{print $1}')
    system_sum=$(sha256sum "$system_file" | awk '{print $1}')

    [ "$data_sum" = "$system_sum" ] ||
        { echo "❌ Las dos copias no coinciden"; exit 20; }

    echo "✅ Copia creada y verificada:"
    echo "   Datos:   $data_file"
    echo "   Sistema: $system_file"
}

retain() {
    local dry_run="${1:-false}"
    local name stamp epoch week biweek month
    local -a files
    local daily=0 weekly=0 biweekly=0 monthly=0
    declare -A keep seen_week seen_biweek seen_month

    mapfile -t files < <(
        find "$DATA_DIR" -maxdepth 1 -type f -name "${PREFIX}*.tar.gz" \
        -printf '%f\n' | sort -r
    )

    for name in "${files[@]}"; do
        if [ "$daily" -lt "$DAILY_KEEP" ]; then
            keep["$name"]=1
            daily=$((daily + 1))
        fi
    done

    for name in "${files[@]}"; do
        [ -n "${keep[$name]:-}" ] && continue
        stamp=${name#"$PREFIX"}; stamp=${stamp%.tar.gz}
        week=$(date -d "${stamp/_/ }" +%G-W%V)
        if [ -z "${seen_week[$week]:-}" ] && [ "$weekly" -lt "$WEEKLY_KEEP" ]; then
            keep["$name"]=1; seen_week["$week"]=1; weekly=$((weekly + 1))
        fi
    done

    for name in "${files[@]}"; do
        [ -n "${keep[$name]:-}" ] && continue
        stamp=${name#"$PREFIX"}; stamp=${stamp%.tar.gz}
        epoch=$(date -d "${stamp/_/ }" +%s)
        biweek=$((epoch / 1209600))
        if [ -z "${seen_biweek[$biweek]:-}" ] && [ "$biweekly" -lt "$BIWEEKLY_KEEP" ]; then
            keep["$name"]=1; seen_biweek["$biweek"]=1; biweekly=$((biweekly + 1))
        fi
    done

    for name in "${files[@]}"; do
        [ -n "${keep[$name]:-}" ] && continue
        stamp=${name#"$PREFIX"}; stamp=${stamp%.tar.gz}
        month=$(date -d "${stamp/_/ }" +%Y-%m)
        if [ -z "${seen_month[$month]:-}" ] && [ "$monthly" -lt "$MONTHLY_KEEP" ]; then
            keep["$name"]=1; seen_month["$month"]=1; monthly=$((monthly + 1))
        fi
    done

    for name in "${files[@]}"; do
        [ -n "${keep[$name]:-}" ] && continue
        if [ "$dry_run" = true ]; then
            echo "SIMULACIÓN: eliminar $name de ambas ubicaciones"
        else
            rm -f "$DATA_DIR/$name" "$SYSTEM_DIR/$name"
            echo "🗑️ Eliminada: $name"
        fi
    done
}

list_backups() {
    ls -lh "$DATA_DIR"/"${PREFIX}"*.tar.gz 2>/dev/null || true
}

case "${1:-}" in
    "") create_backup ;;
    clean) retain false ;;
    clean-dry-run) retain true ;;
    list) list_backups ;;
    *)
        echo "Uso: fumetaos backup [clean|clean-dry-run|list]"
        exit 1
        ;;
esac
