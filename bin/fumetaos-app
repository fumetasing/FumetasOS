#!/bin/bash

###########################################################
# FumetaOS
# Apps
###########################################################

source "$(dirname "$0")/../core/common.sh"
source "$CORE_DIR/apps.sh"


listar_apps()
{

echo
echo "📦 Aplicaciones"
echo

FOUND=0

for APP in $(app_list)
do

    app_load "$APP"

    printf "🟢 %-15s (%s)\n" "$APP_NAME" "$APP_TYPE"

    FOUND=1

done


if [ "$FOUND" -eq 0 ]; then

    echo "No hay aplicaciones registradas."

fi

echo

}


resolver_app()
{

APP_ID="$1"

if [ -z "$APP_ID" ]; then

    echo "❌ Falta indicar aplicación"
    return 1

fi


APP_PATH=$(app_find "$APP_ID")


if [ -z "$APP_PATH" ]; then

    echo "❌ Aplicación no encontrada: $APP_ID"
    return 1

fi

echo "$APP_PATH"

}


actualizar_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_update "$APP_PATH"

}


reiniciar_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_restart "$APP_PATH"

}


logs_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_logs "$APP_PATH"

}


estado_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_status "$APP_PATH"

}


version_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_load "$APP_PATH" || return 1

echo
echo "📦 $APP_NAME"
echo
echo "Versión: $APP_VERSION"
echo "Imagen: $APP_IMAGE:$APP_TAG"
echo

}


case "$1" in

list)

    listar_apps
    ;;


update)

    actualizar_app "$2"
    ;;


restart)

    reiniciar_app "$2"
    ;;


logs)

    logs_app "$2"
    ;;


status)

    estado_app "$2"
    ;;


version)

    version_app "$2"
    ;;


*)

    echo
    echo "Uso:"
    echo
    echo "fumetaos app list"
    echo "fumetaos app update <app>"
    echo "fumetaos app restart <app>"
    echo "fumetaos app logs <app>"
    echo "fumetaos app status <app>"
    echo "fumetaos app version <app>"
    echo

    ;;

esac
