#!/bin/bash

###########################################################
# FumetaOS
# Apps
###########################################################

###########################################################
# Cargar núcleo FumetaOS
###########################################################

source "$(dirname "$0")/../core/common.sh"
source "$CORE_DIR/apps.sh"

###########################################################
# Lista aplicaciones
###########################################################

listar_apps()
{

echo
echo "📦 Aplicaciones"
echo

FOUND=0

for APP in $(app_list)
do

    app_load "$APP"

    printf "🟢 %-15s (%s)\n" "$APP_NAME" "$APP_TYPE"

    FOUND=1

done


if [ "$FOUND" -eq 0 ]; then

    echo "No hay aplicaciones registradas."

fi

echo

}

###########################################################
# Actualizar aplicación
###########################################################

actualizar_app()
{

APP_ID="$1"

if [ -z "$APP_ID" ]; then

    echo "❌ Falta indicar aplicación"
    return 1

fi


APP_PATH=$(app_find "$APP_ID")


if [ -z "$APP_PATH" ]; then

    echo "❌ Aplicación no encontrada: $APP_ID"
    return 1

fi


app_update "$APP_PATH"

}

###########################################################
# Reiniciar aplicación
###########################################################

reiniciar_app()
{

APP_ID="$1"

if [ -z "$APP_ID" ]; then

    echo "❌ Falta indicar aplicación"
    return 1

fi


APP_PATH=$(app_find "$APP_ID")


if [ -z "$APP_PATH" ]; then

    echo "❌ Aplicación no encontrada: $APP_ID"
    return 1

fi


app_restart "$APP_PATH"

}

###########################################################
# Mostrar logs aplicación
###########################################################

logs_app()
{

APP_ID="$1"

if [ -z "$APP_ID" ]; then

    echo "❌ Falta indicar aplicación"
    return 1

fi


APP_PATH=$(app_find "$APP_ID")


if [ -z "$APP_PATH" ]; then

    echo "❌ Aplicación no encontrada: $APP_ID"
    return 1

fi


app_logs "$APP_PATH"

}

###########################################################
# Menú
###########################################################

case "$1" in

list)

    listar_apps
    ;;


update)

    actualizar_app "$2"
    ;;


restart)

    reiniciar_app "$2"
    ;;


logs)

    logs_app "$2"
    ;;


*)

    echo
    echo "Uso:"
    echo
    echo "fumetaos app list"
    echo "fumetaos app update <app>"
    echo "fumetaos app restart <app>"
    echo "fumetaos app logs <app>"
    echo

    ;;

esac
