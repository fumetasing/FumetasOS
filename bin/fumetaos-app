#!/bin/bash

###########################################################
# FumetaOS
# Apps Manager v2
###########################################################

source "$(dirname "$0")/../core/common.sh"
source "$CORE_DIR/apps.sh"
source "$CORE_DIR/casaos.sh"
source "$CORE_DIR/generator.sh"


ayuda_app()
{

echo
echo "Uso:"
echo

echo "fumetaos app list"
echo "   Listar aplicaciones"

echo

echo "fumetaos app info <app>"
echo "   Información completa"

echo

echo "fumetaos app generate <app>"
echo "   Generar recursos de aplicación"

echo

echo "fumetaos app metadata <app>"
echo "   Generar metadata CasaOS"

echo

echo "fumetaos app install <app>"
echo "   Instalar aplicación"

echo

echo "fumetaos app update <app>"
echo "   Actualizar aplicación"

echo

echo "fumetaos app restart <app>"
echo "   Reiniciar aplicación"

echo

echo "fumetaos app logs <app>"
echo "   Ver logs"

echo

echo "fumetaos app remove <app>"
echo "   Eliminar aplicación"

echo

}


resolver_app()
{

APP_PATH=$(app_find "$1")


if [ -z "$APP_PATH" ]; then

    echo "❌ Aplicación no encontrada: $1" >&2
    return 1

fi


echo "$APP_PATH"

}


listar_apps()
{

echo
echo "📦 Aplicaciones"
echo


TOTAL=0


for APP in $(app_list)
do

    app_load "$APP"

    TOTAL=$((TOTAL+1))


    echo "🟢 $APP_NAME"

    [ -n "$APP_DESCRIPTION" ] && echo "   $APP_DESCRIPTION"

    [ -n "$APP_CATEGORY" ] && echo "   Categoría: $APP_CATEGORY"

    echo "   Versión: $APP_VERSION"

    if app_running; then
        echo "   Estado: 🟢 Ejecutando"
    else
        echo "   Estado: 🔴 Detenido"
    fi

    echo

done


echo "Total: $TOTAL"

echo

}


info_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_load "$APP_PATH"


echo
echo "📦 $APP_NAME"
echo

echo "Descripción: $APP_DESCRIPTION"
echo "Categoría: $APP_CATEGORY"
echo "Autor: $APP_AUTHOR"

echo

echo "Imagen: $APP_IMAGE:$APP_TAG"
echo "Contenedor: $(app_container)"

echo

echo "Puerto: $APP_PORT"
echo "URL: $APP_URL"

echo

echo "Compose: $APP_COMPOSE"
echo "Datos: $APP_DATA"

echo


if app_running; then
    echo "Estado: 🟢 Ejecutando"
else
    echo "Estado: 🔴 Detenido"
fi


echo

}


generar_app()
{

APP_PATH=$(resolver_app "$1") || return 1


echo
echo "📦 Generando aplicación"
echo


generate_app_structure "$APP_PATH"

generate_compose "$APP_PATH"

casaos_generate "$APP_PATH"


echo
echo "✅ Generación completada"

echo

}


metadata_app()
{

APP_PATH=$(resolver_app "$1") || return 1

casaos_generate "$APP_PATH"

}


instalar_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_install "$APP_PATH"

}


actualizar_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_update "$APP_PATH"

}


reiniciar_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_restart "$APP_PATH"

}


logs_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_logs "$APP_PATH"

}


eliminar_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_remove "$APP_PATH"

}


case "$1" in


list)

listar_apps
;;


info)

info_app "$2"
;;


generate)

generar_app "$2"
;;


metadata)

metadata_app "$2"
;;


install)

instalar_app "$2"
;;


update)

actualizar_app "$2"
;;


restart)

reiniciar_app "$2"
;;


logs)

logs_app "$2"
;;


remove)

eliminar_app "$2"
;;


help|*)

ayuda_app
;;


esac
