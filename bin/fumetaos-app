#!/bin/bash

###########################################################
# FumetaOS
# Apps
###########################################################

source "$(dirname "$0")/../core/common.sh"
source "$CORE_DIR/apps.sh"


listar_apps()
{

echo
echo "📦 Aplicaciones"
echo

FOUND=0

for APP in $(app_list)
do

    app_load "$APP"

    printf "🟢 %-15s (%s)\n" "$APP_NAME" "$APP_TYPE"

    FOUND=1

done


if [ "$FOUND" -eq 0 ]; then

    echo "No hay aplicaciones registradas."

fi

echo

}


resolver_app()
{

APP_ID="$1"

if [ -z "$APP_ID" ]; then

    echo "❌ Falta indicar aplicación" >&2
    return 1

fi


APP_PATH=$(app_find "$APP_ID")


if [ -z "$APP_PATH" ]; then

    echo "❌ Aplicación no encontrada: $APP_ID" >&2
    return 1

fi

echo "$APP_PATH"

}


instalar_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_install "$APP_PATH"

}


actualizar_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_update "$APP_PATH"

}


reiniciar_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_restart "$APP_PATH"

}


logs_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_logs "$APP_PATH"

}


estado_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_status "$APP_PATH"

}


version_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_load "$APP_PATH" || return 1

echo
echo "📦 $APP_NAME"
echo
echo "Versión: $APP_VERSION"
echo "Imagen: $APP_IMAGE:$APP_TAG"
echo

}


info_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_load "$APP_PATH" || return 1


echo
echo "📦 Información de $APP_NAME"
echo

echo "ID: $APP_ID"
echo "Nombre: $APP_NAME"
echo "Tipo: $APP_TYPE"
echo "Versión: $APP_VERSION"
echo "Imagen: $APP_IMAGE:$APP_TAG"
echo "Compose: $APP_COMPOSE"
echo "Datos: $APP_DATA"

echo

if app_running
then
    echo "Estado: 🟢 Ejecutando"
else
    echo "Estado: 🔴 Detenido"
fi

echo

}


eliminar_app()
{

APP_PATH=$(resolver_app "$1") || return 1

app_load "$APP_PATH" || return 1


echo
echo "⚠️ Vas a eliminar $APP_NAME"
echo "¿Continuar? (y/N)"

read -r CONFIRM


if [ "$CONFIRM" != "y" ]; then

    echo "❌ Cancelado"
    return 1

fi


app_remove "$APP_PATH"

}


case "$1" in

list)

    listar_apps
    ;;


install)

    instalar_app "$2"
    ;;


update)

    actualizar_app "$2"
    ;;


restart)

    reiniciar_app "$2"
    ;;


logs)

    logs_app "$2"
    ;;


status)

    estado_app "$2"
    ;;


version)

    version_app "$2"
    ;;


info)

    info_app "$2"
    ;;


remove)

    eliminar_app "$2"
    ;;


*)

    echo
    echo "Uso:"
    echo
    echo "fumetaos app list"
    echo "fumetaos app install <app>"
    echo "fumetaos app update <app>"
    echo "fumetaos app restart <app>"
    echo "fumetaos app logs <app>"
    echo "fumetaos app status <app>"
    echo "fumetaos app version <app>"
    echo "fumetaos app info <app>"
    echo "fumetaos app remove <app>"
    echo

    ;;

esac
