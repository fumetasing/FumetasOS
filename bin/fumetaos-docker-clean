#!/bin/bash

# Limpieza segura de Docker:
# - Borra caché de compilación sin uso.
# - Borra imágenes huérfanas con más de siete días.
# - Nunca borra contenedores, volúmenes ni imágenes etiquetadas.

set -euo pipefail

if ! docker info >/dev/null 2>&1; then
        echo "❌ Docker no está disponible"
        exit 20
fi

echo "🐳 Limpieza semanal segura de Docker"
echo
echo "===== ANTES ====="
docker system df

echo
echo "===== CACHÉ SIN USO ====="
docker builder prune --all --force

echo
echo "===== IMÁGENES HUÉRFANAS DE MÁS DE 7 DÍAS ====="
docker image prune \
        --filter "until=168h" \
        --force

echo
echo "===== DESPUÉS ====="
docker system df

echo
echo "✅ Limpieza Docker terminada"
