#!/bin/bash

set -euo pipefail

SOURCE_BASE="/DATA/TimeCapsule/Multimedia"

FOLDERS=(
    AVANTIS
    Nenas
    Peliculas
    Series
)

MAC_USER="fumetasing"
MAC_HOST="192.168.1.5"
MAC_ROOT="/Users/fumetasing/FumetaOS-Server"
MAC_DESTINATION="$MAC_ROOT/TimeCapsule/Multimedia"
MAC_USB_MOUNT="/Volumes/Data USB"
MINIMUM_FREE_KB=$((50 * 1024 * 1024))
DELETE_LIMIT=20

SSH_KEY="/home/server/.ssh/id_ed25519_fumetaos_mac"
SSH_KNOWN_HOSTS="/home/server/.ssh/known_hosts"
LOCK_FILE="/run/lock/fumetaos-mac-backup.lock"
TELEGRAM_NOTIFY="/opt/fumetaos/bin/telegram-notify"

DRY_RUN=()
ALLOW_LARGE_DELETE=0
CURRENT_STEP="Preparación"

enviar_telegram()
{
    local message="$1"

    if [ ! -x "$TELEGRAM_NOTIFY" ]; then
        echo "⚠️ No se puede enviar Telegram: falta $TELEGRAM_NOTIFY"
        return 0
    fi

    if ! printf '%s\n' "$message" | "$TELEGRAM_NOTIFY"; then
        echo "⚠️ No se pudo enviar la notificación de Telegram"
    fi
}

notificar_error()
{
    local status="$1"
    local detail="$2"

    [ "${#DRY_RUN[@]}" -eq 0 ] || return 0

    enviar_telegram "🔴 FumetaOS ERROR

Copia de Time Capsule al Mac fallida

Paso: $CURRENT_STEP
Detalle: $detail
Código: $status

⏱️ $(date '+%d/%m/%Y %H:%M')"
}

mostrar_error()
{
    local message="$1"

    echo "❌ $message"
    notificar_error 20 "$message"
    exit 20
}

manejar_error()
{
    local status="$?"

    trap - ERR

    echo
    echo "🔴 La copia de Time Capsule ha fallado en: $CURRENT_STEP"

    notificar_error "$status" "El comando no terminó correctamente"

    exit "$status"
}

comprobar_usb_mac()
{
    if ! "${SSH_COMMAND[@]}" \
        "$MAC_USER@$MAC_HOST" \
        /bin/sh -s <<'REMOTE'
ROOT="/Users/fumetasing/FumetaOS-Server"
EXPECTED_MOUNT="/Volumes/Data USB"
MINIMUM_FREE_KB=52428800

punto_montaje()
{
    df -P "$1" |
        awk 'NR == 2 { sub(/^.* [0-9][0-9]*%[[:space:]]*/, ""); print }'
}

[ -d "$ROOT" ] || exit 20

MOUNT_POINT=$(punto_montaje "$ROOT") || exit 20
[ "$MOUNT_POINT" = "$EXPECTED_MOUNT" ] || exit 20

[ -r "$ROOT" ] && [ -w "$ROOT" ] && [ -x "$ROOT" ] || exit 20

AVAILABLE_KB=$(df -kP "$ROOT" |
    awk 'NR == 2 { print $4 }')

case "$AVAILABLE_KB" in
    ""|*[!0-9]*)
        exit 20
        ;;
esac

[ "$AVAILABLE_KB" -ge "$MINIMUM_FREE_KB" ] || exit 20
REMOTE
    then
        mostrar_error "El USB del Mac no está listo, no es el disco esperado o tiene menos de 50 GiB libres"
    fi
}

preparar_destinos_mac()
{
    if ! "${SSH_COMMAND[@]}" \
        "$MAC_USER@$MAC_HOST" \
        /bin/sh -s <<'REMOTE'
ROOT="/Users/fumetasing/FumetaOS-Server"
TARGET="/Users/fumetasing/FumetaOS-Server/TimeCapsule/Multimedia"
EXPECTED_MOUNT="/Volumes/Data USB"

punto_montaje()
{
    df -P "$1" |
        awk 'NR == 2 { sub(/^.* [0-9][0-9]*%[[:space:]]*/, ""); print }'
}

[ -d "$ROOT" ] || exit 20

MOUNT_POINT=$(punto_montaje "$ROOT") || exit 20
[ "$MOUNT_POINT" = "$EXPECTED_MOUNT" ] || exit 20

mkdir -p \
    "$TARGET/AVANTIS" \
    "$TARGET/Nenas" \
    "$TARGET/Peliculas" \
    "$TARGET/Series"

for DIRECTORY in \
    "$TARGET/AVANTIS" \
    "$TARGET/Nenas" \
    "$TARGET/Peliculas" \
    "$TARGET/Series"
do
    [ -d "$DIRECTORY" ] || exit 20

    DIRECTORY_MOUNT=$(punto_montaje "$DIRECTORY") || exit 20
    [ "$DIRECTORY_MOUNT" = "$EXPECTED_MOUNT" ] || exit 20
done
REMOTE
    then
        mostrar_error "No se pudo preparar Multimedia en el USB correcto del Mac"
    fi
}

validar_destinos_mac()
{
    if ! "${SSH_COMMAND[@]}" \
        "$MAC_USER@$MAC_HOST" \
        /bin/sh -s <<'REMOTE'
TARGET="/Users/fumetasing/FumetaOS-Server/TimeCapsule/Multimedia"
EXPECTED_MOUNT="/Volumes/Data USB"

punto_montaje()
{
    df -P "$1" |
        awk 'NR == 2 { sub(/^.* [0-9][0-9]*%[[:space:]]*/, ""); print }'
}

for DIRECTORY in \
    "$TARGET/AVANTIS" \
    "$TARGET/Nenas" \
    "$TARGET/Peliculas" \
    "$TARGET/Series"
do
    [ -d "$DIRECTORY" ] || exit 20

    MOUNT_POINT=$(punto_montaje "$DIRECTORY") || exit 20
    [ "$MOUNT_POINT" = "$EXPECTED_MOUNT" ] || exit 20
done
REMOTE
    then
        mostrar_error "Falta alguna carpeta de Multimedia en el USB correcto del Mac"
    fi
}

preparar_directorios_destino()
{
    local source_dir="$1"
    local destination_dir="$2"

    if ! find "$source_dir" -type d -printf '%P\n' |
        "${SSH_COMMAND[@]}" \
            "$MAC_USER@$MAC_HOST" \
            "while IFS= read -r RELATIVE
            do
                [ -z \"\$RELATIVE\" ] ||
                    mkdir -p '$destination_dir'/\"\$RELATIVE\"
            done"
    then
        mostrar_error "No se pudo preparar la estructura de carpetas en el Mac"
    fi
}

comprobar_borrados_previstos()
{
    local source_dir="$1"
    local rsync_destination="$2"
    local folder="$3"
    local delete_count

    [ "$ALLOW_LARGE_DELETE" -eq 0 ] || {
        echo "⚠️ Freno de borrados omitido manualmente para: $folder"
        return
    }

    CURRENT_STEP="Comprobación de borrados en $folder"

    if ! delete_count=$(
        rsync \
            -aH \
            --no-owner \
            --no-group \
            --dry-run \
            --delete-delay \
            --itemize-changes \
            --out-format='%i' \
            -e "ssh -i $SSH_KEY -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=30 -o ServerAliveCountMax=6 -o UserKnownHostsFile=$SSH_KNOWN_HOSTS -o StrictHostKeyChecking=yes" \
            "$source_dir" \
            "$rsync_destination" |
            awk '$0 == "*deleting" { count++ } END { print count + 0 }'
    )
    then
        mostrar_error "No se pudo comprobar los borrados previstos en $folder"
    fi

    case "$delete_count" in
        ""|*[!0-9]*)
            mostrar_error "No se pudo interpretar los borrados previstos en $folder"
            ;;
    esac

    if [ "$delete_count" -gt "$DELETE_LIMIT" ]; then
        mostrar_error "Se cancelarían $delete_count borrados en $folder; límite automático: $DELETE_LIMIT"
    fi

    if [ "$delete_count" -gt 0 ]; then
        echo "🛡️ Borrados previstos en $folder: $delete_count/$DELETE_LIMIT"
    fi
}

case "${1:-}" in
    "")
        ;;
    --dry-run)
        DRY_RUN=(--dry-run)
        ;;
    --allow-large-delete)
        ALLOW_LARGE_DELETE=1
        ;;
    *)
        echo "Uso:"
        echo "fumetaos-timecapsule-mac-backup"
        echo "fumetaos-timecapsule-mac-backup --dry-run"
        echo "fumetaos-timecapsule-mac-backup --allow-large-delete"
        exit 20
        ;;
esac

trap manejar_error ERR

[ "$(id -u)" -eq 0 ] ||
    mostrar_error "Esta copia debe ejecutarse como root"

mountpoint -q /DATA/TimeCapsule ||
    mostrar_error "/DATA/TimeCapsule no está montado"

for FOLDER in "${FOLDERS[@]}"
do
    [ -d "$SOURCE_BASE/$FOLDER" ] ||
        mostrar_error "No existe el origen: $SOURCE_BASE/$FOLDER"
done

[ -r "$SSH_KEY" ] ||
    mostrar_error "No existe la clave SSH: $SSH_KEY"

[ -r "$SSH_KNOWN_HOSTS" ] ||
    mostrar_error "No existe el archivo de hosts SSH conocidos: $SSH_KNOWN_HOSTS"

exec 9>"$LOCK_FILE"

flock -n 9 ||
    mostrar_error "Ya hay una copia al Mac en curso"

SSH_COMMAND=(
    ssh
    -i "$SSH_KEY"
    -o BatchMode=yes
    -o ConnectTimeout=20
    -o ServerAliveInterval=30
    -o ServerAliveCountMax=6
    -o "UserKnownHostsFile=$SSH_KNOWN_HOSTS"
    -o StrictHostKeyChecking=yes
)

CURRENT_STEP="Comprobación del Mac y del disco USB"
comprobar_usb_mac

if [ "${#DRY_RUN[@]}" -gt 0 ]; then
    validar_destinos_mac
else
    CURRENT_STEP="Preparación de los destinos en el USB del Mac"
    preparar_destinos_mac
fi

echo "💾 Copia espejo de Time Capsule al Mac"
echo "📍 Origen: $SOURCE_BASE"
echo "📍 Destino: $MAC_DESTINATION"
echo "💾 USB validado: $MAC_USB_MOUNT"
echo "🛡️ Límite automático de borrados: $DELETE_LIMIT por carpeta"
echo

for FOLDER in "${FOLDERS[@]}"
do
    SOURCE_DIR="$SOURCE_BASE/$FOLDER/"
    DESTINATION_DIR="$MAC_DESTINATION/$FOLDER"
    RSYNC_DESTINATION="$MAC_USER@$MAC_HOST:$DESTINATION_DIR/"

    CURRENT_STEP="Copia de $FOLDER"
    echo "📁 Copiando: $FOLDER"

    if [ "${#DRY_RUN[@]}" -eq 0 ]; then
        preparar_directorios_destino \
            "$SOURCE_DIR" \
            "$DESTINATION_DIR"

        comprobar_borrados_previstos \
            "$SOURCE_DIR" \
            "$RSYNC_DESTINATION" \
            "$FOLDER"

        CURRENT_STEP="Copia de $FOLDER"
    fi

    rsync \
        -aH \
        --no-owner \
        --no-group \
        --delete-delay \
        --partial \
        --human-readable \
        --stats \
        "${DRY_RUN[@]}" \
        -e "ssh -i $SSH_KEY -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=30 -o ServerAliveCountMax=6 -o UserKnownHostsFile=$SSH_KNOWN_HOSTS -o StrictHostKeyChecking=yes" \
        "$SOURCE_DIR" \
        "$RSYNC_DESTINATION"

    echo
done

trap - ERR

if [ "${#DRY_RUN[@]}" -gt 0 ]; then
    echo "✅ Simulación completada: no se ha copiado ni borrado nada"
else
    echo "✅ Copia espejo de Time Capsule completada"
fi
